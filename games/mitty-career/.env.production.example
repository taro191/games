# คัดลอกเป็น .env  (ห้ามนำ .env ขึ้น Git หรือแชร์ให้ใคร)

# โดเมนที่ชี้ A record มาที่ IP ของเซิร์ฟเวอร์ เช่น game.example.com
DOMAIN=game.example.com

# local = อีเมล+รหัสผ่าน | 500w = ผ่าน 500 Windows Thailand เท่านั้น (แนะนำสำหรับใช้งานจริง) | both = ทั้งสอง
AUTH_MODE=500w

# 1 = เปิดปุ่ม "ลองเล่นก่อน (ไม่ต้องสมัคร)" บันทึกในเบราว์เซอร์ผู้เล่น ไม่ข้ามเครื่อง | 0 = ต้องเข้าสู่ระบบก่อนเสมอ
# ถ้าต้องการให้เข้าได้ผ่าน 500 Windows เท่านั้นจริงๆ ให้ตั้งเป็น 0
ALLOW_GUEST=0

# ===== ใช้เมื่อ AUTH_MODE เป็น 500w หรือ both  (ขอจากทีม 500 Windows) =====
W500_AUTH_URL=
W500_TOKEN_URL=
W500_USERINFO_URL=
W500_CLIENT_ID=
W500_CLIENT_SECRET=
# ต้องลงทะเบียนกับ 500 Windows ให้ตรงกัน (เปลี่ยนโดเมนให้ตรงกับ DOMAIN)
W500_REDIRECT_URI=https://game.example.com/auth/500w/callback
W500_SCOPE=openid profile email
W500_ID_FIELD=sub
W500_NAME_FIELD=name
W500_EMAIL_FIELD=email
