# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ไฟล์ .env ห้ามเผยแพร่)
PORT=3000
# ข้อความลับสำหรับเซ็นตั๋วล็อกอิน ควรยาวและสุ่ม ถ้าไม่ตั้ง ทุกคนจะหลุดล็อกอินเมื่อรีสตาร์ทเซิร์ฟเวอร์
SECRET=change-me-to-a-long-random-string
# ตั้งเป็น 1 เมื่ออยู่หลัง nginx/reverse proxy
#TRUST_PROXY=1

# ---- เข้าสู่ระบบผ่านระบบภายนอก OAuth2 / OpenID Connect (ไม่บังคับ) ----
#PUBLIC_URL=https://game.example.com
#SSO_NAME=500 Windows Thailand
#SSO_CLIENT_ID=
#SSO_CLIENT_SECRET=
# แบบ A: ผู้ให้บริการมี discovery
#SSO_ISSUER=https://provider.example.com
# แบบ B: ระบุ URL เอง
#SSO_AUTH_URL=
#SSO_TOKEN_URL=
#SSO_USERINFO_URL=
#SSO_SCOPE=openid profile
