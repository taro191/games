# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า  (รันด้วย: npm run start:env  ต้องใช้ Node 20.6 ขึ้นไป)
PORT=3000

# 1 = เปิดปุ่ม "ลองเล่นก่อน (ไม่ต้องสมัคร)" (บันทึกในเบราว์เซอร์ ไม่ข้ามเครื่อง) | 0 = ต้องเข้าสู่ระบบก่อนเสมอ
ALLOW_GUEST=0

# วิธีเข้าสู่ระบบ:  local = อีเมล+รหัสผ่าน | 500w = ผ่าน 500 Windows Thailand เท่านั้น | both = ทั้งสองแบบ
AUTH_MODE=local

# ที่เก็บข้อมูลผู้เล่น (ควรเป็นโฟลเดอร์ที่ถาวรและสำรองข้อมูลไว้) ค่าเริ่มต้น: server/data
# DATA_DIR=/var/lib/mitty90

# ใช้ HTTPS แล้วให้ตั้งเป็น 1 (คุกกี้จะถูกส่งผ่าน HTTPS เท่านั้น)
COOKIE_SECURE=0
# อยู่หลัง reverse proxy (nginx/Caddy/Cloudflare) ให้ตั้งเป็น 1 เพื่ออ่าน IP จริงสำหรับจำกัดการลองรหัสผ่าน
TRUST_PROXY=0
# ไม่ต้องตั้งก็ได้ เซิร์ฟเวอร์จะสร้างและเก็บคีย์ให้เองใน DATA_DIR/secret.key
# SESSION_SECRET=

# ===== Login ผ่าน 500 Windows Thailand (ใช้เมื่อ AUTH_MODE เป็น 500w หรือ both) =====
# ค่าเหล่านี้ต้องได้จากทีม 500 Windows (OAuth2 Authorization Code)
# W500_AUTH_URL=https://...        # หน้าให้ผู้ใช้ล็อกอินและอนุญาต
# W500_TOKEN_URL=https://...       # ที่แลก code เป็น access token
# W500_USERINFO_URL=https://...    # ที่ขอข้อมูลสมาชิกด้วย access token
# W500_CLIENT_ID=
# W500_CLIENT_SECRET=
# W500_REDIRECT_URI=https://โดเมนของคุณ/auth/500w/callback   # ต้องลงทะเบียนกับ 500 Windows ให้ตรงกัน
# W500_SCOPE=openid profile email
# W500_ID_FIELD=sub                # ชื่อฟิลด์ใน userinfo ที่เป็นรหัสสมาชิกที่ไม่เปลี่ยน
# W500_NAME_FIELD=name
# W500_EMAIL_FIELD=email

# ===== ทดสอบกับตัวจำลอง (npm run mock500w ในอีกหน้าต่าง) =====
# AUTH_MODE=500w
# W500_AUTH_URL=http://127.0.0.1:4302/authorize
# W500_TOKEN_URL=http://127.0.0.1:4302/token
# W500_USERINFO_URL=http://127.0.0.1:4302/userinfo
# W500_CLIENT_ID=cid
# W500_CLIENT_SECRET=sec
# W500_REDIRECT_URI=http://localhost:3000/auth/500w/callback
# W500_ID_FIELD=member_id
